<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 🔝 Título o nombre -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre"
        android:textSize="20sp"
        android:textAlignment="center"
        android:textStyle="bold"
        android:padding="8dp" />

    <!-- Divider superior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginVertical="8dp"/>

    <!-- 📈 Espacio para futura gráfica -->
    <FrameLayout
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="533dp"
        android:layout_weight="1"
        android:background="#F5F5F5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Espacio para gráfica"
            android:textColor="#666666"
            android:textSize="16sp" />
    </FrameLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginVertical="8dp"/>

    <!-- 📝 Columna de textos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Modo Simulación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo Simulación"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <Switch
                android:id="@+id/switchSimulacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Datos Reales"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Datos Simulados"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/linea1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Línea 1" />

            <TextView
                android:id="@+id/linea1_anterior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/linea2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Línea 2" />

            <TextView
                android:id="@+id/linea2_anterior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/linea3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Línea 3" />

            <TextView
                android:id="@+id/linea3_anterior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/infoText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Línea 4" />

            <TextView
                android:id="@+id/infoText_anterior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="65dp"
                android:layout_height="67dp"
                android:backgroundTint="#2196F3"
                android:text=""
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnSendData"
                android:layout_width="65dp"
                android:layout_height="67dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#4CAF50"
                android:text=""
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnSendSimulatedData"
                android:layout_width="65dp"
                android:layout_height="67dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#FF9800"
                android:text=""
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/processingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Datos procesando"
            android:textColor="#666666"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 🔘 Botón a la derecha -->
    <Button
        android:id="@+id/btnSmile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=":)"
        android:textSize="24sp" />

    <!-- Recomendación de la bomba -->
    <TextView
        android:id="@+id/pumpRecommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:textColor="#666666"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Divider inferior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginVertical="8dp"/>

    <!-- ⬇ Contenedor inferior con texto + 4 círculos -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🔘 Círculos -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">
            <View
                android:id="@+id/led0"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/led_off"
                android:layout_margin="4dp" />
            <View
                android:id="@+id/led1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/led_off"
                android:layout_margin="4dp" />
            <View
                android:id="@+id/led2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/led_off"
                android:layout_margin="4dp" />
            <View
                android:id="@+id/led3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/led_off"
                android:layout_margin="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
